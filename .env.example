DB_PATH=D:\IncidentHub\Data\Dev\incident-hub-dev.sqlite
INCIDENT_IMAGES_DIR=D:\IncidentHub\Data\Dev\IncidentImages
HOSTNAME=0.0.0.0
PORT=3001

# Local username/password authentication
AUTH_DISABLED=false
AUTH_MODE=LOCAL
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_SESSION_HOURS=12
AUTH_COOKIE_SECURE=false
AUTH_TRUST_PROXY_HEADERS=false
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_SOURCE_MAX_FAILURES=50
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_LOCK_SECONDS=900
LOCAL_AUTH_BOOTSTRAP_EMAIL=admin@example.local
LOCAL_AUTH_BOOTSTRAP_PASSWORD=replace-once-then-remove

HEALTH_DETAILS_SECRET=replace-with-at-least-32-random-characters
SEED_DEMO_DATA=false
IMPORT_BUNDLED_REPORT=false
SQLITE_BUSY_TIMEOUT_MS=30000
STARTUP_MIN_FREE_DISK_MB=512
MIN_FREE_DISK_MB=1024
BACKUP_DIR=D:\IncidentHub\Backups\Dev
BACKUP_RETENTION_COUNT=14

# Optional integrations
ELK_WEBHOOK_SECRET=
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=
PRTG_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
