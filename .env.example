# Windows/Linux local SQLite database
DB_PATH=C:\ProgramData\ElkIncidentHub\data\incident-hub.sqlite

# Listen on the datacenter LAN. Restrict TCP/3000 with Windows Firewall.
HOSTNAME=0.0.0.0
PORT=3000

# Temporary pilot mode: no login. Every reachable client has ADMIN access.
AUTH_DISABLED=true
NOAUTH_ADMIN_EMAIL=monitoring-admin@af.hadc.me
NOAUTH_ADMIN_NAME=Monitoring Administrator

# Kept for an easy future switch back to authenticated mode.
DASHBOARD_OWNER_EMAILS=monitoring-admin@af.hadc.me
AUTH_USER_HEADER=x-authenticated-user
AUTH_NAME_HEADER=x-authenticated-name
AUTH_EMAIL_DOMAIN=af.hadc.me
AUTH_PROXY_SECRET=

# ELK/Kibana webhook authentication. Generate a long random value.
ELK_WEBHOOK_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE

# Optional internal mail gateway
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=

# Clean production defaults
SEED_DEMO_DATA=false
IMPORT_BUNDLED_REPORT=false
LOAD_DEFAULT_SERVICE_CATALOG=true

# Production hardening and storage safeguards
APP_VERSION=1.2.0-rc1
SQLITE_BUSY_TIMEOUT_MS=10000
MIN_FREE_DISK_MB=1024
STARTUP_MIN_FREE_DISK_MB=512
PRODUCTION_MIN_FREE_DISK_MB=4096
BACKUP_DIR=C:\ProgramData\ElkIncidentHub\backups
BACKUP_RETENTION_COUNT=14
