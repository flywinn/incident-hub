# Windows/Linux local SQLite database
DB_PATH=C:\ProgramData\ElkIncidentHub\data\incident-hub.sqlite

# Listen on the datacenter LAN. Restrict the application port with Windows Firewall.
HOSTNAME=0.0.0.0
PORT=3000

# Development/pilot bypass. Production must keep this false.
AUTH_DISABLED=false
NOAUTH_ADMIN_EMAIL=admin@example.local
NOAUTH_ADMIN_NAME=Monitoring Administrator

# Simple local login for small teams.
# To enable: AUTH_DISABLED=false and AUTH_MODE=LOCAL
AUTH_MODE=LOCAL
AUTH_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_SESSION_HOURS=12
# true when the site is served over HTTPS. Leave false only for trusted HTTP/LAN testing.
AUTH_COOKIE_SECURE=false
# Trust X-Forwarded-For only when direct access to Node is blocked by the firewall.
AUTH_TRUST_PROXY_HEADERS=false

# Login brute-force protection (per account plus a wider source bucket).
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_SOURCE_MAX_FAILURES=50
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_LOCK_SECONDS=900

# Required for detailed /api/health data. The public response only reports status.
HEALTH_DETAILS_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE

# First local-login bootstrap. This existing account becomes the protected SUPER_ADMIN.
# After the first successful login and after setting passwords for other users,
# remove LOCAL_AUTH_BOOTSTRAP_PASSWORD from the production environment.
LOCAL_AUTH_BOOTSTRAP_EMAIL=admin@example.local
LOCAL_AUTH_BOOTSTRAP_PASSWORD=REPLACE_WITH_A_STRONG_INITIAL_PASSWORD

# Optional reverse-proxy/Windows auth mode retained for future use.
DASHBOARD_OWNER_EMAILS=admin@example.local
AUTH_USER_HEADER=x-authenticated-user
AUTH_NAME_HEADER=x-authenticated-name
AUTH_EMAIL_DOMAIN=example.local
AUTH_PROXY_SECRET=

# ELK/Kibana webhook authentication. Generate a long random value.
ELK_WEBHOOK_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE

# Optional internal mail gateway
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=

# Clean production defaults
SEED_DEMO_DATA=false
IMPORT_BUNDLED_REPORT=false
LOAD_DEFAULT_SERVICE_CATALOG=true

# Production hardening and storage safeguards
APP_VERSION=1.15.0
# Stable installer may populate this with the exact deployed Git commit.
APP_COMMIT=
SQLITE_BUSY_TIMEOUT_MS=10000
MIN_FREE_DISK_MB=1024
STARTUP_MIN_FREE_DISK_MB=512
PRODUCTION_MIN_FREE_DISK_MB=4096
BACKUP_DIR=C:\ProgramData\ElkIncidentHub\backups
BACKUP_RETENTION_COUNT=14

# Uploaded incident screenshots (JPG/PNG/WebP, max 10 MB each)
INCIDENT_IMAGES_DIR=D:\IncidentHub\Data\Prod\IncidentImages
