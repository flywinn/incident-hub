{
    "name": "incident-hub-onprem",
    "version": "1.14.0",
    "private": true,
    "engines": {
        "node": ">=22.13.0"
    },
    "scripts": {
        "dev": "next dev --webpack -H 0.0.0.0 -p 3001",
        "build": "next build && node scripts/prepare-standalone.mjs",
        "start": "node scripts/start-server.mjs",
        "test": "npm run build && node --test tests/*.test.mjs",
        "lint": "eslint . --ignore-pattern .next --ignore-pattern data --ignore-pattern backups",
        "audit": "npm audit --audit-level=high",
        "verify": "npm run lint && npm run test && npm run audit",
        "db:backup": "node scripts/backup-db.mjs",
        "db:check": "node scripts/check-db.mjs",
        "prod:check": "node scripts/check-production.mjs",
        "prod:smoke": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-production.ps1",
        "db:migrate": "node scripts/migrate-db.mjs"
    },
    "dependencies": {
        "@fontsource-variable/vazirmatn": "^5.3.0",
        "better-sqlite3": "^12.2.0",
        "next": "16.3.0",
        "react": "19.2.6",
        "react-dom": "19.2.6"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "4.2.1",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "22.19.19",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "eslint": "9.39.4",
        "eslint-config-next": "16.3.0",
        "tailwindcss": "4.2.1",
        "typescript": "5.9.3"
    },
    "type": "module",
    "displayName": "سامانه مدیریت رخداد IncidentHub - On-Prem"
}
